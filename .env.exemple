# Copier en .env et renseigner. Le .env n'est jamais commité (.gitignore).

# Development expose Swagger et les routes /api/dev/* : convention pour le local
# et la recette. Production pour la prod.
ASPNETCORE_ENVIRONMENT=Development

# Instance Flowise de classification. Le FlowId se récupère auprès de l'équipe,
# il ne s'écrit dans aucun fichier suivi.
Flowise__BaseUrl=https://valia-flowise.val.local
Flowise__FlowId=

# Bypass du certificat interne de Flowise en recette. Refusé en Production.
Flowise__AllowInvalidTls=true
