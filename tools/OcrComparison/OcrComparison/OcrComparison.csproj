<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="F23.StringSimilarity" Version="7.0.1" />
      <PackageReference Include="OpenCvSharp5" Version="5.0.0.20260730" />
      <PackageReference Include="OpenCvSharp5.runtime.win.slim" Version="5.0.0.20260730" />
      <PackageReference Include="PdfPig" Version="0.1.15" />
      <PackageReference Include="PDFtoImage" Version="5.3.0" />
      <PackageReference Include="RapidOcrNet" Version="4.1.0" />
      <PackageReference Include="Tesseract" Version="5.2.0" />
      <Content Include="..\..\..\models\tessdata\**">
        <Link>tessdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\..\..\models\v6\**">
        <Link>models\v6\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
